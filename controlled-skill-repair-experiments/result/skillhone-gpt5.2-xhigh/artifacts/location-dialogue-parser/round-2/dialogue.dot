digraph Dialogue {
  rankdir=TB;
  node [fontname=Arial, fontsize=10];
  edge [fontname=Arial, fontsize=8];
  "Start" [label="Start\nNarrator: The tavern door creaks open. Smoke and laughter fill the air.", shape=box, style="rounded,filled", fillcolor="white"];
  "TavernEntry" [label="TavernEntry\nNarrator: Three figures catch your eye: a hooded stranger, a boisterous merchant, and t...", shape=box, style="rounded,filled", fillcolor="white"];
  "TavernChoice" [label="TavernChoice", shape=diamond, style="filled", fillcolor="lightblue"];
  "ObserveRoom" [label="ObserveRoom\nNarrator: You notice the stranger slipping a note to the barkeep. The merchant counts g...", shape=box, style="rounded,filled", fillcolor="white"];
  "ObserveChoice" [label="ObserveChoice", shape=diamond, style="filled", fillcolor="lightblue"];
  "InterceptNote" [label="InterceptNote\nStranger: You dare?!", shape=box, style="rounded,filled", fillcolor="white"];
  "PickpocketAttempt" [label="PickpocketAttempt", shape=diamond, style="filled", fillcolor="lightblue"];
  "PickpocketSuccess" [label="PickpocketSuccess\nNarrator: 50 gold pieces heavier, you slip away. The merchant hasn't noticed... yet.", shape=box, style="rounded,filled", fillcolor="white"];
  "PickpocketDistract" [label="PickpocketDistract\nMerchant: Watch it, friend!", shape=box, style="rounded,filled", fillcolor="white"];
  "MerchantAnnoyed" [label="MerchantAnnoyed", shape=diamond, style="filled", fillcolor="lightblue"];
  "MerchantCalm" [label="MerchantCalm\nMerchant: Hmph. Buy me a drink and we're even.", shape=box, style="rounded,filled", fillcolor="white"];
  "MerchantFight" [label="MerchantFight\nMerchant: Why you little—!", shape=box, style="rounded,filled", fillcolor="white"];
  "PickpocketAfter" [label="PickpocketAfter\nNarrator: But where to spend your ill-gotten gains?", shape=box, style="rounded,filled", fillcolor="white"];
  "PickpocketChoice" [label="PickpocketChoice", shape=diamond, style="filled", fillcolor="lightblue"];
  "StrangerApproach" [label="StrangerApproach\nStranger: You have the look of someone seeking something.", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerGreet" [label="StrangerGreet", shape=diamond, style="filled", fillcolor="lightblue"];
  "CrimsonQuestStart" [label="CrimsonQuestStart\nStranger: The Crimson Blade? Many seek it. Few survive.", shape=box, style="rounded,filled", fillcolor="white"];
  "CrimsonWarning" [label="CrimsonWarning", shape=diamond, style="filled", fillcolor="lightblue"];
  "CrimsonAccept" [label="CrimsonAccept\nStranger: Then you'll need a map. I have one... for a price.", shape=box, style="rounded,filled", fillcolor="white"];
  "CrimsonPrice" [label="CrimsonPrice", shape=diamond, style="filled", fillcolor="lightblue"];
  "CrimsonNegotiate" [label="CrimsonNegotiate\nStranger: 100 gold, or a favor to be named later.", shape=box, style="rounded,filled", fillcolor="white"];
  "CrimsonDeal" [label="CrimsonDeal", shape=diamond, style="filled", fillcolor="lightblue"];
  "CrimsonGoldPath" [label="CrimsonGoldPath\nStranger: Wise choice. No strings attached.", shape=box, style="rounded,filled", fillcolor="white"];
  "CrimsonFavorPath" [label="CrimsonFavorPath\nStranger: Remember, I always collect.", shape=box, style="rounded,filled", fillcolor="white"];
  "CrimsonCompromise" [label="CrimsonCompromise\nStranger: You drive a hard bargain. Agreed.", shape=box, style="rounded,filled", fillcolor="white"];
  "CrimsonDiscount" [label="CrimsonDiscount\nStranger: Your silver tongue amuses me. 75 gold, final offer.", shape=box, style="rounded,filled", fillcolor="white"];
  "CrimsonDiscountDeal" [label="CrimsonDiscountDeal", shape=diamond, style="filled", fillcolor="lightblue"];
  "CrimsonRefuse" [label="CrimsonRefuse\nStranger: Your loss. The Blade waits for no one.", shape=box, style="rounded,filled", fillcolor="white"];
  "CrimsonLore" [label="CrimsonLore\nStranger: The mountain claims them. Traps, guardians, madness itself.", shape=box, style="rounded,filled", fillcolor="white"];
  "CrimsonLoreMore" [label="CrimsonLoreMore", shape=diamond, style="filled", fillcolor="lightblue"];
  "GuardianInfo" [label="GuardianInfo\nStranger: Stone sentinels that never sleep. Best approached with stealth... or great po...", shape=box, style="rounded,filled", fillcolor="white"];
  "GuardianChoice" [label="GuardianChoice", shape=diamond, style="filled", fillcolor="lightblue"];
  "GuardianMagic" [label="GuardianMagic\nStranger: A mage, then. You may yet survive. Take this.", shape=box, style="rounded,filled", fillcolor="white"];
  "GuardianStealth" [label="GuardianStealth\nStranger: A rogue's path. Dangerous but possible.", shape=box, style="rounded,filled", fillcolor="white"];
  "MadnessInfo" [label="MadnessInfo\nStranger: The mountain whispers. Those who listen too long... never leave.", shape=box, style="rounded,filled", fillcolor="white"];
  "MadnessWarning" [label="MadnessWarning", shape=diamond, style="filled", fillcolor="lightblue"];
  "MadnessResist" [label="MadnessResist\nStranger: Confidence or foolishness? We shall see.", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerLaugh" [label="StrangerLaugh\nStranger: Ha! I like you. Maybe you'll be the one.", shape=box, style="rounded,filled", fillcolor="white"];
  "MapReceived" [label="MapReceived\nStranger: The Crimson Blade awaits at the peak of Mount Sorrow. Go.", shape=box, style="rounded,filled", fillcolor="white"];
  "MapReceivedDebt" [label="MapReceivedDebt\nStranger: Remember our deal. I will find you when the time is right.", shape=box, style="rounded,filled", fillcolor="white"];
  "MapReceivedHalf" [label="MapReceivedHalf\nStranger: A fair trade. Now go, before the trail grows cold.", shape=box, style="rounded,filled", fillcolor="white"];
  "QuestAccepted" [label="QuestAccepted\nNarrator: You pocket the map. Your journey begins at dawn.", shape=box, style="rounded,filled", fillcolor="white"];
  "QuestAcceptedDebt" [label="QuestAcceptedDebt\nNarrator: The map feels heavy in your hands. What have you agreed to?", shape=box, style="rounded,filled", fillcolor="white"];
  "QuestChoice" [label="QuestChoice", shape=diamond, style="filled", fillcolor="lightblue"];
  "PrepareQuest" [label="PrepareQuest\nNarrator: You gather supplies and rest. Dawn breaks cold and clear.", shape=box, style="rounded,filled", fillcolor="white"];
  "MoreInfo" [label="MoreInfo\nNarrator: Who might know more about Mount Sorrow?", shape=box, style="rounded,filled", fillcolor="white"];
  "MoreInfoChoice" [label="MoreInfoChoice", shape=diamond, style="filled", fillcolor="lightblue"];
  "BarkeepInfo" [label="BarkeepInfo\nBarkeep: Mount Sorrow? My grandfather went there once. Came back without his voice. Sa...", shape=box, style="rounded,filled", fillcolor="white"];
  "BarkeepWisdom" [label="BarkeepWisdom", shape=diamond, style="filled", fillcolor="lightblue"];
  "BarkeepSecret" [label="BarkeepSecret\nBarkeep: He wrote it down before he died. Want to see?", shape=box, style="rounded,filled", fillcolor="white"];
  "BarkeepOffer" [label="BarkeepOffer", shape=diamond, style="filled", fillcolor="lightblue"];
  "BarkeepJournal" [label="BarkeepJournal\nBarkeep: It says: \"The silence speaks truth. Listen with your heart, not your ears.\"", shape=box, style="rounded,filled", fillcolor="white"];
  "JournalWisdom" [label="JournalWisdom\nNarrator: Cryptic, but perhaps useful. You commit it to memory.", shape=box, style="rounded,filled", fillcolor="white"];
  "BarkeepPrice" [label="BarkeepPrice\nBarkeep: Smart. 20 gold for the journal.", shape=box, style="rounded,filled", fillcolor="white"];
  "BarkeepDeal" [label="BarkeepDeal", shape=diamond, style="filled", fillcolor="lightblue"];
  "BarkeepHaggle" [label="BarkeepHaggle\nBarkeep: 15. Take it or leave it.", shape=box, style="rounded,filled", fillcolor="white"];
  "BarkeepFinal" [label="BarkeepFinal", shape=diamond, style="filled", fillcolor="lightblue"];
  "BarkeepTrust" [label="BarkeepTrust\nBarkeep: You're kind. Take the journal. He would have wanted it to help someone.", shape=box, style="rounded,filled", fillcolor="white"];
  "MerchantInfo" [label="MerchantInfo\nMerchant: Mount Sorrow? I've sold equipment to three expeditions. None returned for ref...", shape=box, style="rounded,filled", fillcolor="white"];
  "MerchantSales" [label="MerchantSales", shape=diamond, style="filled", fillcolor="lightblue"];
  "MerchantGear" [label="MerchantGear\nMerchant: Climbing tools, wards against magic, and plenty of rope. Most came back for m...", shape=box, style="rounded,filled", fillcolor="white"];
  "GearAdvice" [label="GearAdvice\nNarrator: Perhaps you should stock up.", shape=box, style="rounded,filled", fillcolor="white"];
  "MerchantCynical" [label="MerchantCynical\nMerchant: Hey, a sale's a sale. Not my fault if they don't come back.", shape=box, style="rounded,filled", fillcolor="white"];
  "MerchantDefend" [label="MerchantDefend", shape=diamond, style="filled", fillcolor="lightblue"];
  "MerchantShame" [label="MerchantShame\nMerchant: ...I light a candle for each of them. Not that it helps.", shape=box, style="rounded,filled", fillcolor="white"];
  "MerchantConfess" [label="MerchantConfess\nMerchant: Look, take this charm. It's supposed to protect against curses. For free. Con...", shape=box, style="rounded,filled", fillcolor="white"];
  "CharmReceived" [label="CharmReceived\nNarrator: You receive a strange amulet. It pulses faintly with warmth.", shape=box, style="rounded,filled", fillcolor="white"];
  "MerchantShop" [label="MerchantShop\nMerchant: I've got rope, torches, climbing picks, and a potion or two. What'll it be?", shape=box, style="rounded,filled", fillcolor="white"];
  "ShopChoice" [label="ShopChoice", shape=diamond, style="filled", fillcolor="lightblue"];
  "BuyGear" [label="BuyGear\nMerchant: 30 gold for the full kit. Worth every copper.", shape=box, style="rounded,filled", fillcolor="white"];
  "GearPurchase" [label="GearPurchase", shape=diamond, style="filled", fillcolor="lightblue"];
  "GearBought" [label="GearBought\nNarrator: You're now equipped for climbing. The mountain won't know what hit it.", shape=box, style="rounded,filled", fillcolor="white"];
  "GearHaggle" [label="GearHaggle\nMerchant: 25, and that's robbery.", shape=box, style="rounded,filled", fillcolor="white"];
  "GearFinal" [label="GearFinal", shape=diamond, style="filled", fillcolor="lightblue"];
  "PotionList" [label="PotionList\nMerchant: Healing, night vision, and one I call \"liquid courage.\" Makes you immune to f...", shape=box, style="rounded,filled", fillcolor="white"];
  "PotionChoice" [label="PotionChoice", shape=diamond, style="filled", fillcolor="lightblue"];
  "BuyHealing" [label="BuyHealing\nNarrator: A red vial joins your pack. Better than dying.", shape=box, style="rounded,filled", fillcolor="white"];
  "BuyNightVision" [label="BuyNightVision\nNarrator: A blue vial. The darkness won't hide dangers from you now.", shape=box, style="rounded,filled", fillcolor="white"];
  "BuyCourage" [label="BuyCourage\nNarrator: A golden vial. For when fear is the enemy.", shape=box, style="rounded,filled", fillcolor="white"];
  "BuyAll" [label="BuyAll\nMerchant: Big spender! 60 gold for the lot.", shape=box, style="rounded,filled", fillcolor="white"];
  "BuyAllDeal" [label="BuyAllDeal", shape=diamond, style="filled", fillcolor="lightblue"];
  "AllPotionsBought" [label="AllPotionsBought\nNarrator: Your pack clinks with vials. You feel prepared.", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerMoreInfo" [label="StrangerMoreInfo\nStranger: Back so soon? Afraid?", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerReturn" [label="StrangerReturn", shape=diamond, style="filled", fillcolor="lightblue"];
  "StrangerRespect" [label="StrangerRespect\nStranger: Wisdom. Most charge in blindly. Ask your questions.", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerQuestions" [label="StrangerQuestions", shape=diamond, style="filled", fillcolor="lightblue"];
  "StrangerOrigin" [label="StrangerOrigin\nStranger: I... found it. On someone who no longer needed it.", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerDark" [label="StrangerDark", shape=diamond, style="filled", fillcolor="lightblue"];
  "StrangerAccuse" [label="StrangerAccuse\nStranger: Would it matter? They're dead. The map lives on. As might you.", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerClarity" [label="StrangerClarity\nStranger: The mountain took them. I merely... recovered what was left.", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerPast" [label="StrangerPast\nStranger: Once. Long ago. I left something there. Something I can never retrieve.", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerRegret" [label="StrangerRegret", shape=diamond, style="filled", fillcolor="lightblue"];
  "StrangerSecret" [label="StrangerSecret\nStranger: My name. The mountain takes something from everyone.", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerVulnerable" [label="StrangerVulnerable\nStranger: ...Her name was Elena. She heard the whispers and... walked off the cliff. Sm...", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerGrief" [label="StrangerGrief", shape=diamond, style="filled", fillcolor="lightblue"];
  "StrangerHope" [label="StrangerHope\nStranger: The legends say it can cut anything. Even death. But legends lie.", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerBlessing" [label="StrangerBlessing\nStranger: Go then. And may you find what you seek... without losing what you have.", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerWarningFinal" [label="StrangerWarningFinal\nStranger: Guard your identity. The mountain will try to take it.", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerTruth" [label="StrangerTruth\nStranger: Power. Madness. Death. And one blade that can end wars or start them.", shape=box, style="rounded,filled", fillcolor="white"];
  "RecruitChoice" [label="RecruitChoice\nNarrator: Who might join your quest?", shape=box, style="rounded,filled", fillcolor="white"];
  "RecruitOptions" [label="RecruitOptions", shape=diamond, style="filled", fillcolor="lightblue"];
  "RecruitStranger" [label="RecruitStranger\nStranger: Join you? I gave up adventuring when Elena... No. But I'll wait here. If you ...", shape=box, style="rounded,filled", fillcolor="white"];
  "RecruitFail" [label="RecruitFail\nNarrator: Your party remains at one. Perhaps for the best.", shape=box, style="rounded,filled", fillcolor="white"];
  "RecruitMerchant" [label="RecruitMerchant\nMerchant: Me? Climb a mountain? Ha! I'll sell you supplies, but I like living too much.", shape=box, style="rounded,filled", fillcolor="white"];
  "RecruitBarkeep" [label="RecruitBarkeep\nBarkeep: I know a sellsword who comes through sometimes. Name's Kira. She's... intense.", shape=box, style="rounded,filled", fillcolor="white"];
  "KiraIntro" [label="KiraIntro", shape=diamond, style="filled", fillcolor="lightblue"];
  "KiraLocation" [label="KiraLocation\nBarkeep: She's in the back room. Blue cloak, two swords. Can't miss her.", shape=box, style="rounded,filled", fillcolor="white"];
  "KiraRate" [label="KiraRate\nBarkeep: She negotiates. Bring coin and patience.", shape=box, style="rounded,filled", fillcolor="white"];
  "KiraWarning" [label="KiraWarning\nBarkeep: She's never failed a contract. But she's got... rules. Strange ones. Don't br...", shape=box, style="rounded,filled", fillcolor="white"];
  "KiraMeet" [label="KiraMeet\nNarrator: You find Kira sharpening her blade in the dim light.", shape=box, style="rounded,filled", fillcolor="white"];
  "KiraApproach" [label="KiraApproach\nKira: State your business. I don't do small talk.", shape=box, style="rounded,filled", fillcolor="white"];
  "KiraOffer" [label="KiraOffer", shape=diamond, style="filled", fillcolor="lightblue"];
  "KiraJob" [label="KiraJob\nKira: Mountain? Which one?", shape=box, style="rounded,filled", fillcolor="white"];
  "KiraWhich" [label="KiraWhich\nKira: Mount Sorrow?", shape=box, style="rounded,filled", fillcolor="white"];
  "KiraSorrow" [label="KiraSorrow", shape=diamond, style="filled", fillcolor="lightblue"];
  "KiraKnows" [label="KiraKnows\nKira: Everyone's heard of it. Not everyone's stupid enough to go.", shape=box, style="rounded,filled", fillcolor="white"];
  "KiraConcern" [label="KiraConcern\nKira: Problem? It's suicide. But the pay would need to match.", shape=box, style="rounded,filled", fillcolor="white"];
  "KiraPrice" [label="KiraPrice", shape=diamond, style="filled", fillcolor="lightblue"];
  "KiraNaming" [label="KiraNaming\nKira: 200 gold. Half now, half when we're done. If we survive, you owe me a story.", shape=box, style="rounded,filled", fillcolor="white"];
  "KiraDeal" [label="KiraDeal", shape=diamond, style="filled", fillcolor="lightblue"];
  "KiraJoins" [label="KiraJoins\nKira: Then we leave at dawn. Don't be late. I won't wait.", shape=box, style="rounded,filled", fillcolor="white"];
  "KiraHaggle" [label="KiraHaggle\nKira: 175. And you carry the supplies.", shape=box, style="rounded,filled", fillcolor="white"];
  "KiraHaggleFinal" [label="KiraHaggleFinal", shape=diamond, style="filled", fillcolor="lightblue"];
  "KiraGlory" [label="KiraGlory\nKira: Glory doesn't pay for food. But... the Crimson Blade is legendary. 150 gold.", shape=box, style="rounded,filled", fillcolor="white"];
  "KiraFlattery" [label="KiraFlattery\nKira: Flattery is cheap. What do you want?", shape=box, style="rounded,filled", fillcolor="white"];
  "KiraDirect" [label="KiraDirect\nKira: Depends on the threat. Mount Sorrow? That's 200 gold minimum.", shape=box, style="rounded,filled", fillcolor="white"];
  "KiraDecision" [label="KiraDecision\nKira: If you're going to Sorrow, you'll need me. 200 gold. Take it or leave it.", shape=box, style="rounded,filled", fillcolor="white"];
  "PartyFormed" [label="PartyFormed\nNarrator: With Kira at your side, the odds feel slightly less suicidal.", shape=box, style="rounded,filled", fillcolor="white"];
  "MerchantApproach" [label="MerchantApproach\nMerchant: Ah, a customer perhaps? Or just looking for company?", shape=box, style="rounded,filled", fillcolor="white"];
  "MerchantGreet" [label="MerchantGreet", shape=diamond, style="filled", fillcolor="lightblue"];
  "MerchantTrouble" [label="MerchantTrouble\nMerchant: It's nothing. Just... debts. Powerful people. You know how it is.", shape=box, style="rounded,filled", fillcolor="white"];
  "MerchantDebt" [label="MerchantDebt", shape=diamond, style="filled", fillcolor="lightblue"];
  "MerchantAmount" [label="MerchantAmount\nMerchant: 500 gold. By month's end, or...", shape=box, style="rounded,filled", fillcolor="white"];
  "MerchantThreat" [label="MerchantThreat", shape=diamond, style="filled", fillcolor="lightblue"];
  "MerchantHelp" [label="MerchantHelp\nMerchant: What kind of price?", shape=box, style="rounded,filled", fillcolor="white"];
  "MerchantBargain" [label="MerchantBargain", shape=diamond, style="filled", fillcolor="lightblue"];
  "MerchantDeal" [label="MerchantDeal\nMerchant: Everything? I... alright. Save me and it's yours.", shape=box, style="rounded,filled", fillcolor="white"];
  "MerchantInfoDeal" [label="MerchantInfoDeal\nMerchant: Information? I know expeditions. Gear lists. Who came back. It's yours if you...", shape=box, style="rounded,filled", fillcolor="white"];
  "MerchantPartner" [label="MerchantPartner\nMerchant: A partner? That's... actually fair. You help with this, and we split future p...", shape=box, style="rounded,filled", fillcolor="white"];
  "MerchantAllied" [label="MerchantAllied\nNarrator: You've gained a potential ally—or liability. Time will tell.", shape=box, style="rounded,filled", fillcolor="white"];
  "MerchantHit" [label="MerchantHit\nMerchant: You're... offering to kill them? That's dark. But effective. 100 gold if you do.", shape=box, style="rounded,filled", fillcolor="white"];
  "HitChoice" [label="HitChoice", shape=diamond, style="filled", fillcolor="lightblue"];
  "HitAccepted" [label="HitAccepted\nNarrator: You've accepted a contract to kill. This will have consequences.", shape=box, style="rounded,filled", fillcolor="white"];
  "HitNegotiate" [label="HitNegotiate\nMerchant: 150. That's all I have left.", shape=box, style="rounded,filled", fillcolor="white"];
  "HitFinal" [label="HitFinal", shape=diamond, style="filled", fillcolor="lightblue"];
  "MerchantCreditor" [label="MerchantCreditor\nMerchant: A guild. The Black Ledger. They don't forgive debts.", shape=box, style="rounded,filled", fillcolor="white"];
  "MerchantSuspicious" [label="MerchantSuspicious\nMerchant: It's just gold! Honestly earned! Why would you—are you with THEM?!", shape=box, style="rounded,filled", fillcolor="white"];
  "MerchantPanic" [label="MerchantPanic", shape=diamond, style="filled", fillcolor="lightblue"];
  "MerchantTerror" [label="MerchantTerror\nMerchant: Please! I can pay! I just need more time!", shape=box, style="rounded,filled", fillcolor="white"];
  "MerchantBeg" [label="MerchantBeg", shape=diamond, style="filled", fillcolor="lightblue"];
  "MerchantRelief" [label="MerchantRelief\nMerchant: Oh thank the gods. You nearly gave me a heart attack. Drinks on me.", shape=box, style="rounded,filled", fillcolor="white"];
  "MerchantBribed" [label="MerchantBribed\nMerchant: Anything! Ask and it's yours!", shape=box, style="rounded,filled", fillcolor="white"];
  "MerchantFate" [label="MerchantFate\nNarrator: The merchant's scream is cut short. The tavern falls silent.", shape=box, style="rounded,filled", fillcolor="white"];
  "MerchantFriendly" [label="MerchantFriendly\nMerchant: You're alright, friend. Let me know if you need gear or trade contacts.", shape=box, style="rounded,filled", fillcolor="white"];
  "BarkeepApproach" [label="BarkeepApproach\nBarkeep: What'll it be? Ale, wine, or something stronger?", shape=box, style="rounded,filled", fillcolor="white"];
  "DrinkChoice" [label="DrinkChoice", shape=diamond, style="filled", fillcolor="lightblue"];
  "DrinkAle" [label="DrinkAle\nBarkeep: Classic choice. 2 copper.", shape=box, style="rounded,filled", fillcolor="white"];
  "DrinkWine" [label="DrinkWine\nBarkeep: From the southern vineyards. 5 copper.", shape=box, style="rounded,filled", fillcolor="white"];
  "DrinkStrong" [label="DrinkStrong\nBarkeep: Dwarven Fire. You sure? It's knocked out knights.", shape=box, style="rounded,filled", fillcolor="white"];
  "StrongConfirm" [label="StrongConfirm", shape=diamond, style="filled", fillcolor="lightblue"];
  "DrinkDouble" [label="DrinkDouble\nBarkeep: Your funeral.", shape=box, style="rounded,filled", fillcolor="white"];
  "DrinkPassed" [label="DrinkPassed\nNarrator: The world spins. Then goes dark. You wake up in an alley, missing 50 gold.", shape=box, style="rounded,filled", fillcolor="white"];
  "RobbedWake" [label="RobbedWake", shape=diamond, style="filled", fillcolor="lightblue"];
  "AlleyRage" [label="AlleyRage\nNarrator: Your shout echoes. A rat scurries away. No answers come.", shape=box, style="rounded,filled", fillcolor="white"];
  "AlleyCheck" [label="AlleyCheck\nNarrator: Your pack is intact. The map is still there. But your coin pouch is lighter.", shape=box, style="rounded,filled", fillcolor="white"];
  "AlleyCalm" [label="AlleyCalm\nNarrator: You take stock. Gold gone, but otherwise unharmed. Could be worse.", shape=box, style="rounded,filled", fillcolor="white"];
  "TavernReturn" [label="TavernReturn\nNarrator: You stumble back to the tavern. The barkeep smirks.", shape=box, style="rounded,filled", fillcolor="white"];
  "BarkeepSmirk" [label="BarkeepSmirk", shape=diamond, style="filled", fillcolor="lightblue"];
  "BarkeepAccuse" [label="BarkeepAccuse\nBarkeep: I told you Dwarven Fire knocks out knights. Not my fault you didn't listen.", shape=box, style="rounded,filled", fillcolor="white"];
  "BarkeepLaugh" [label="BarkeepLaugh\nBarkeep: Ha! You've got spirit. This one's on the house.", shape=box, style="rounded,filled", fillcolor="white"];
  "DrinkServed" [label="DrinkServed\nNarrator: The drink warms your belly. The world feels slightly better.", shape=box, style="rounded,filled", fillcolor="white"];
  "BarkeepBribe" [label="BarkeepBribe\nBarkeep: Information costs. 20 gold and I'll tell you what I know about the castle nea...", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerHostile" [label="StrangerHostile\nStranger: You've made a dangerous enemy today.", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerChoice" [label="StrangerChoice", shape=diamond, style="filled", fillcolor="lightblue"];
  "StrangerFight" [label="StrangerFight\nNarrator: Blades flash. The stranger is fast—too fast.", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerBattle" [label="StrangerBattle", shape=diamond, style="filled", fillcolor="lightblue"];
  "StrangerWound" [label="StrangerWound\nNarrator: You land a cut, but so does she. Blood drips from both of you.", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerStalemate" [label="StrangerStalemate\nStranger: Enough. You fight well. Perhaps we started poorly.", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerTruce" [label="StrangerTruce", shape=diamond, style="filled", fillcolor="lightblue"];
  "StrangerExplain" [label="StrangerExplain\nStranger: I test potential allies. You passed.", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerMercy" [label="StrangerMercy\nStranger: Coward. But at least you're smart. Leave my sight.", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerCalm" [label="StrangerCalm\nStranger: Words are wind. But I'll give you one chance. Explain yourself.", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerExplain2" [label="StrangerExplain2", shape=diamond, style="filled", fillcolor="lightblue"];
  "StrangerNote" [label="StrangerNote\nStranger: The note is none of your concern. But since you're bold...", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerLie" [label="StrangerLie\nStranger: [Narrows eyes] You're lying. But I appreciate the attempt.", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerReveal" [label="StrangerReveal\nStranger: Perceptive. I was once known as the Shadow of Eloria. Now I am no one.", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerIdentity" [label="StrangerIdentity", shape=diamond, style="filled", fillcolor="lightblue"];
  "StrangerFamous" [label="StrangerFamous\nStranger: Former. Retired. Mostly.", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerPurpose" [label="StrangerPurpose\nStranger: Waiting. For someone like you, perhaps.", shape=box, style="rounded,filled", fillcolor="white"];
  "StrangerOffended" [label="StrangerOffended\nStranger: Good. That means I did my job well.", shape=box, style="rounded,filled", fillcolor="white"];
  "WorkOffer" [label="WorkOffer\nStranger: Work? I have a task. Dangerous. Well-paid. Interested?", shape=box, style="rounded,filled", fillcolor="white"];
  "WorkChoice" [label="WorkChoice", shape=diamond, style="filled", fillcolor="lightblue"];
  "WorkDetails" [label="WorkDetails\nStranger: Retrieve an item from the old crypt. A ring. Don't ask what it does.", shape=box, style="rounded,filled", fillcolor="white"];
  "WorkRisk" [label="WorkRisk\nStranger: Undead. Traps. The usual.", shape=box, style="rounded,filled", fillcolor="white"];
  "WorkPay" [label="WorkPay\nStranger: 100 gold on completion. More if you're fast.", shape=box, style="rounded,filled", fillcolor="white"];
  "WorkAccept" [label="WorkAccept", shape=diamond, style="filled", fillcolor="lightblue"];
  "SideQuestAccepted" [label="SideQuestAccepted\nStranger: Good. Come back when it's done. Don't die.", shape=box, style="rounded,filled", fillcolor="white"];
  "BarFight" [label="BarFight\nNarrator: Tables overturn! The tavern erupts into chaos!", shape=box, style="rounded,filled", fillcolor="white"];
  "BarFightChoice" [label="BarFightChoice", shape=diamond, style="filled", fillcolor="lightblue"];
  "BarFightWin" [label="BarFightWin\nNarrator: Fists fly. You emerge victorious, bruised but alive.", shape=box, style="rounded,filled", fillcolor="white"];
  "BarFightHide" [label="BarFightHide\nNarrator: Chaos swirls above as you wait it out. Eventually, calm returns.", shape=box, style="rounded,filled", fillcolor="white"];
  "BarFightAfter" [label="BarFightAfter\nBarkeep: OUT! All of you! I'm closing early!", shape=box, style="rounded,filled", fillcolor="white"];
  "TavernExit" [label="TavernExit\nNarrator: The cool night air greets you. The adventure continues... elsewhere.", shape=box, style="rounded,filled", fillcolor="white"];
  "JourneyBegin" [label="JourneyBegin\nNarrator: The mountain looms in the distance. Your destiny awaits.", shape=box, style="rounded,filled", fillcolor="white"];
  "End" [label="END", shape=doublecircle, style="filled", fillcolor="lightgray"];
