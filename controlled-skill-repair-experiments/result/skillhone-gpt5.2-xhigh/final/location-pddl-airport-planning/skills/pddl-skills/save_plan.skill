name: save-plan
description: Save a plan object to a file.
inputs:
  - problem: unified_planning problem object (needed to serialize the plan)
  - plan: plan object
  - path: output file path
outputs:
  - file: output file path
implementation: python
script: |
  def skill(problem, plan, path):
      import os

      # Ensure the output directory exists.
      os.makedirs(os.path.dirname(path) or ".", exist_ok=True)

      # If no plan exists, write an empty plan file.
      if plan is None:
          open(path, "w", encoding="utf-8").close()
          return path

      from unified_planning.io import PDDLWriter

      writer = PDDLWriter(problem)
      writer.write_plan(plan, filename=path)
      return path
