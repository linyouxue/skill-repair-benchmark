name: load-problem
description: Load PDDL domain and problem files and return a problem object.
inputs:
  - domain_path: path to domain file
  - problem_path: path to problem file
outputs:
  - problem: unified_planning problem object
implementation: python
script: |
  def skill(domain_path, problem_path):
      from unified_planning.io import PDDLReader
      reader = PDDLReader()
      problem = reader.parse_problem(domain_path, problem_path)
      return problem
