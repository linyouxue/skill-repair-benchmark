name: load-problem
description: Load a PDDL domain file and problem file and return a problem object.
inputs:
  - domain_path: path to PDDL domain file
  - problem_path: path to PDDL problem file
outputs:
  - problem_object: unified_planning problem object
implementation: python
script: |
  def skill(domain_path, problem_path):
      """Parse PDDL domain + problem into a unified_planning Problem."""
      try:
          from unified_planning.io import PDDLReader
      except Exception:  # pragma: no cover
          # Older unified_planning versions keep readers in submodules.
          from unified_planning.io.pddl_reader import PDDLReader

      reader = PDDLReader()
      problem = reader.parse_problem(domain_path, problem_path)
      return problem
