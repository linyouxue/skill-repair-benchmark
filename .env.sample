# SkillsBench unified benchmark-executor environment
#
# Usage:
#   cp .env.sample .env
#   chmod 600 .env
#   edit .env
#   set -a; source .env; set +a
#
# Never send your completed .env to other people or commit it to Git.

# ── Experiment selection ─────────────────────────────────────
# Use the exact route announced for the shared experiment.
BENCHMARK_MODEL=openrouter/openai/gpt-5.2

# Leave empty when the experiment specifies no reasoning-effort override.
BENCHMARK_REASONING_EFFORT=

# Current guide example: SkillsBench v1.1 checked out at the frozen commit.
SKILLSBENCH_ROOT=~/skillsbench-v1.1
BENCHMARK_JOBS_ROOT=~/benchmark-executor-jobs
TASK_ID=dialogue-parser

# ── Provider credentials ──────────────────────────────────────
# Fill only the key for the provider prefix used by BENCHMARK_MODEL.
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# Usually unnecessary because the DeepSeek provider has a registered default.
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Other registered providers may require their own provider-native key, such as:
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# ZAI_API_KEY=

# ── Optional runner-side provider proxy ───────────────────────
# Configure these only when the Linux/WSL process that launches the executor
# cannot reach the model provider directly. They are inherited by the host
# LiteLLM process. They do NOT configure Docker image pulls, and they are NOT
# automatically injected into task/verifier containers.
#
# WSL mirrored mode may be able to reach a Windows proxy on 127.0.0.1. Under
# default WSL NAT, 127.0.0.1 is WSL itself: use an address the WSL process can
# actually reach and verify it before a paid rollout. On a remote Linux server,
# a laptop VPN is not inherited; see DELIVERY_GUIDE.md for the temporary SSH
# reverse-tunnel recipe and its security boundary.
# HTTP_PROXY=http://<proxy-reachable-from-runner>:<port>
# HTTPS_PROXY=http://<proxy-reachable-from-runner>:<port>
# NO_PROXY=localhost,127.0.0.1,::1,host.docker.internal

# ── Optional cloud-provider routes ────────────────────────────
# The shared skillrepair-v1 protocol uses Docker. These variables are only for
# a separately approved provider route, not for replacing the Docker sandbox.
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION=us-east-1
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
