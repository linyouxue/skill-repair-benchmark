-            QualityStatus.CRITICAL: 0.3,
-            QualityStatus.UNKNOWN: 0.5
-        }
-
-        if not metrics:
-            return QualityStatus.UNKNOWN, 0.5
-
-        total_score = 0
-        count = 0
-        has_critical = False
-        has_warning = False
-
-        for metric_result in metrics.values():
