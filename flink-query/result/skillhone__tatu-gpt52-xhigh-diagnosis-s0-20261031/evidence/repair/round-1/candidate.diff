+class ConfigValidator:
+    """Validates streaming pipeline configurations."""
+
+    REQUIRED_FIELDS = ['name', 'source', 'sink']
+    VALID_SOURCE_TYPES = ['kafka', 'kinesis', 'pubsub', 'file']
+    VALID_SINK_TYPES = ['kafka', 's3', 'postgres', 'elasticsearch', 'console']
