+    def generate_streams_config(
+        self,
+        application_id: str,
+        bootstrap_servers: str = None,
+        state_dir: str = None,
+        processing_guarantee: str = "exactly_once_v2"
+    ) -> Dict[str, Any]:
+        """Generate Kafka Streams configuration."""
+        config = {
+            "application.id": application_id,
