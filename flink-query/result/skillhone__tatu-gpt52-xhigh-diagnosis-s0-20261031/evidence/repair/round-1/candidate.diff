-            data = json.loads(value)
-            return {
-                'event_id': data.get('event_id'),
-                'user_id': data.get('user_id'),
-                'event_type': data.get('event_type'),
-                'timestamp': data.get('timestamp'),
-                'properties': data.get('properties', {}),
-                'value': float(data.get('value', 0))
