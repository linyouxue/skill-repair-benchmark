FROM bf__simpo-code-reproduction:latest
USER root
COPY cpython-3.10.19+20251028-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz /tmp/python310.tar.gz
COPY uv-0.9.7-x86_64-unknown-linux-gnu.tar.gz /tmp/uv.tar.gz
RUN mkdir -p /opt/py310 /root/.local/bin /tmp/uv-extract \
 && tar -xzf /tmp/python310.tar.gz --strip-components=1 -C /opt/py310 \
 && tar -xzf /tmp/uv.tar.gz -C /tmp/uv-extract \
 && cp /tmp/uv-extract/uv-x86_64-unknown-linux-gnu/uv /root/.local/bin/uv \
 && cp /tmp/uv-extract/uv-x86_64-unknown-linux-gnu/uvx /root/.local/bin/uvx \
 && chmod 0755 /root/.local/bin/uv /root/.local/bin/uvx \
 && rm -rf /tmp/python310.tar.gz /tmp/uv.tar.gz /tmp/uv-extract \
 && /opt/py310/bin/python --version 2>&1 | grep -F 3.10.19 \
 && /root/.local/bin/uv --version | grep -F "uv 0.9.7"
RUN /root/.local/bin/uv pip install --python /opt/py310/bin/python \
      --index-url https://download.pytorch.org/whl/cpu \
      --extra-index-url https://pypi.org/simple \
      pytest==8.4.1 pytest-json-ctrf==0.3.5 numpy==1.24.2 torch==2.1.2+cpu \
      transformers==4.39.3 trl==0.9.6 rich==11.2.0 peft==0.9.0 \
      accelerate==0.29.2 datasets==2.18.0
