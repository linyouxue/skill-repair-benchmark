+# Protocol revision: rar-confidence-consistency-v1.
+# Public template specifies 95% one-sided, without a decimal rounding rule.
+# Preserve the original reference convention as well as correctly rounded quantiles.
+# Validate the confidence assumption independently, then propagate it consistently.
+def validated_confidence(ws):
+    actual = cell_value(ws, "C3")
+    exact = NormalDist().inv_cdf(0.95)
+    supported = [EXPECTED_STEP1["C3"][1], exact] + [round(exact, digits) for digits in range(2, 9)]
+    assert isinstance(actual, (int, float)) and math.isfinite(actual)
+    assert any(abs(actual - z) <= 1e-8 for z in supported), (
+        f"C3 must be a 95% one-sided normal quantile or its 2+ decimal rounding, got {actual}"
+    )
+    return actual
+
