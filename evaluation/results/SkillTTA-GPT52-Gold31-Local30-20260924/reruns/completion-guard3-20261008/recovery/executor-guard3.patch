+def test_opt_in_guard_three_retries_then_exhausts_without_resetting_budget(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """Guards the opt-in guard3 patch on base commit 603c7db2: no extra step budget."""
+    (tmp_path / "one").mkdir()
+    (tmp_path / "one" / "SKILL.md").write_text("BODY")
+    env = _adapter_env(tmp_path)
+    env[adapter.ENV_TEXT_ONLY_RETRY_LIMIT] = "3"
+    local_agent, _ = _install_fake_openhands(monkeypatch)
+    monkeypatch.setattr(adapter, "_PATCHED", False)
+    adapter.install_adapter(env)
+    conversation = local_agent.Conversation(agent=_Agent(), workspace="/app")
+    conversation._benchmark_executor_total_iterations = 56
+    emitted = []
+    for index in range(4):
+        conversation.agent.step(conversation)
+        conversation.agent._handle_content_response(
+            _Message(role="assistant", content=[_TextContent(text="text tool call")]),
+            SimpleNamespace(id=f"response-{index}"),
+            conversation,
+            conversation.state,
+            emitted.append,
+        )
+        assert conversation._benchmark_executor_text_only_retries_used == min(
+            index + 1, 3
+        )
+        assert conversation._benchmark_executor_total_iterations == 57 + index
+        assert conversation.kwargs["max_iteration_per_run"] == 60
+        assert conversation.state.execution_status == (
+            _ExecutionStatus.RUNNING if index < 3 else _ExecutionStatus.FINISHED
+        )
+    assert len(emitted) == 3
+    assert conversation._benchmark_executor_text_only_retry_exhausted is True
+
+
