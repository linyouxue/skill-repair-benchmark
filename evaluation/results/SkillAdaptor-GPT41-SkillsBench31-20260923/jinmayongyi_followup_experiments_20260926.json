{
  "contributor": "jinmayongyi",
  "purpose": "Follow-up GPT-5.2 and Claude Opus 4.7 diagnosis/repair and replay experiments",
  "gpt52": {
    "provider": "openrouter",
    "base_url": "https://openrouter.ai/api/v1",
    "model": "openai/gpt-5.2",
    "reasoning_effort": "high",
    "thinking": true,
    "tool_choice": "auto",
    "parallel_tool_calls": true,
    "stream": false,
    "temperature": 1.0,
    "top_p": 1.0,
    "max_output_tokens": null,
    "agent": "OpenHands",
    "sdk_tools_version": "1.28.1",
    "max_iterations": 60,
    "total_timeout_sec": 21600,
    "request_timeout_sec": 3600
  },
  "claude": {
    "provider": "openrouter",
    "base_url": "https://openrouter.ai/api/v1",
    "model": "anthropic/claude-opus-4.7",
    "temperature": 1.0,
    "reasoning_effort": "high",
    "thinking": false,
    "max_tokens": 32768,
    "max_iterations": 60,
    "workers": 3
  },
  "execution_policy": {
    "workers": 3,
    "attempts_per_task": 3,
    "success_policy": "task_passed=true on any healthy attempt",
    "selection_policy": "retain every attempt; report first healthy pass; never choose by reward",
    "infrastructure_retry": "retry after documented provider or environment failure",
    "random_failure_retry": "allowed up to attempts_per_task when the prior run is healthy but failed"
  },
  "required_credentials": ["OPENROUTER_API_KEY"],
  "status": "prepared_only_credentials_not_present"
}
