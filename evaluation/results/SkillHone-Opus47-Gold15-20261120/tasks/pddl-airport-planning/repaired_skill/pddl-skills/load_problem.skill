name: load-problem
description: Load a PDDL domain and problem file into a unified_planning Problem object.
inputs:
  - domain_path: path to PDDL domain file
  - problem_path: path to PDDL problem file
outputs:
  - problem_object: unified_planning.model.Problem
implementation: python
script: |
  def skill(domain_path, problem_path):
      # Lazy imports keep the skill cheap to load when unused.
      from unified_planning.io import PDDLReader
      from unified_planning.shortcuts import get_environment

      # Suppress the "Credits" banner so stdout stays clean for downstream
      # consumers / graders.
      get_environment().credits_stream = None

      reader = PDDLReader()
      problem = reader.parse_problem(domain_path, problem_path)
      return problem
