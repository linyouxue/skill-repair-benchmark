name: generate-plan
description: Generate a sequential classical plan for a unified_planning Problem. Prefers calling the pyperplan CLI with an admissible A* configuration so the plan is returned in lifted "(action arg1 arg2 ...)" form; falls back to the unified_planning OneshotPlanner path when the CLI is unavailable.
inputs:
  - problem: unified_planning.model.Problem
  - planner_name: optional planner engine name, defaults to "pyperplan"
  - timeout: optional planner timeout in seconds
  - search: optional pyperplan search algorithm (e.g. "astar", "wastar", "bfs")
  - heuristic: optional pyperplan heuristic (e.g. "hmax", "blind", "lmcut", "hff")
  - prefer_optimal: when True (default) try to obtain a cost-optimal plan
  - domain_path: optional path to the PDDL domain file; when provided together with problem_path, generate-plan runs pyperplan directly so the plan preserves lifted action names and the full parameter list expected by downstream text graders
  - problem_path: optional path to the PDDL problem file (see domain_path)
outputs:
  - plan: a sequential plan exposing ``.actions`` where each entry has ``.action.name`` and ``.actual_parameters`` (an iterable whose elements expose ``.name``). Returns ``None`` when no plan was found.
implementation: python
script: |
  def skill(problem, planner_name="pyperplan", timeout=None,
            search=None, heuristic=None, prefer_optimal=True,
            domain_path=None, problem_path=None):
      """Return a sequential plan for *problem* in lifted form.

      Classical-planning graders in this benchmark compare plan text verbatim,
      one action per line, using the **lifted** ``action_name(arg1, arg2, ...)``
      syntax taken from the PDDL domain. ``unified_planning``'s pyperplan
      bridge compiles the problem via its Grounder and returns an UP plan
      whose ``ActionInstance.action.name`` is the grounded operator name
      (e.g. ``move_seg_rw_0_400_seg_rww_0_50_south_south_medium``) with only
      the remaining free parameter(s) listed in ``actual_parameters`` — not
      the lifted form the grader needs.

      To avoid that, we try pyperplan as an external process first: its
      ``.soln`` output is one ``(action arg1 arg2 ...)`` IPC line per step
      using the **original** lifted action name and the full parameter list
      in the lifted action's declared order. We then rebuild a real UP
      ``SequentialPlan`` (so ``validate`` still works) when possible; if the
      UP wiring fails for any reason we fall back to a thin proxy plan with
      the same ``.actions`` / ``.action.name`` / ``.actual_parameters`` API
      that ``save-plan`` already relies on.

      When ``domain_path`` / ``problem_path`` are not provided (or the
      pyperplan CLI is missing), we fall back to the previous UP
      ``OneshotPlanner`` strategies: optimal engine via
      ``OptimalityGuarantee`` first, then the named planner configured for
      admissible A*, then the planner defaults.

      ``search`` / ``heuristic`` let callers override the pyperplan knobs
      and default to ``astar`` / ``hmax`` (admissible) when
      ``prefer_optimal`` is true.
      """
      import os
      import re
      import shutil
      import subprocess
      import sys
      import tempfile
      import warnings

      warnings.filterwarnings("ignore")

      requested_search = search or ("astar" if prefer_optimal else None)
      requested_heuristic = heuristic or ("hmax" if prefer_optimal else None)

      # ---- lightweight plan proxy used when we can't build a real UP plan
      class _ParamProxy:
          __slots__ = ("name",)

          def __init__(self, s):
              self.name = str(s)

          def __str__(self):
              return self.name

      class _ActionProxy:
          __slots__ = ("name",)

          def __init__(self, s):
              self.name = str(s)

      class _ActionInstanceProxy:
          __slots__ = ("action", "actual_parameters")

          def __init__(self, name, args):
              self.action = _ActionProxy(name)
              self.actual_parameters = tuple(_ParamProxy(a) for a in args)

      class _SequentialPlanProxy:
          __slots__ = ("actions",)

          def __init__(self, steps):
              self.actions = [_ActionInstanceProxy(n, a) for (n, a) in steps]

      def _parse_soln(path):
          steps = []
          with open(path, "r") as fh:
              for raw in fh:
                  line = raw.strip()
                  if not line or line.startswith(";"):
                      continue
                  # pyperplan writes one action per line as "(name a b c)".
                  m = re.match(r"^\(\s*(.*?)\s*\)\s*$", line)
                  inner = m.group(1) if m else line
                  toks = inner.split()
                  if not toks:
                      continue
                  steps.append((toks[0], toks[1:]))
          return steps

      def _build_real_up_plan(steps):
          """Best-effort conversion of parsed steps into a UP SequentialPlan.

          Returns ``None`` on any lookup / construction failure — callers
          should fall back to the proxy plan in that case.
          """
          try:
              from unified_planning.plans import SequentialPlan, ActionInstance
          except Exception:
              return None
          try:
              actions_by_name = {a.name.lower(): a for a in problem.actions}
          except Exception:
              return None
          objs_by_name = {}
          try:
              for o in problem.all_objects:
                  objs_by_name[o.name.lower()] = o
          except Exception:
              try:
                  for t in problem.user_types:
                      for o in problem.objects(t):
                          objs_by_name[o.name.lower()] = o
              except Exception:
                  return None
          instances = []
          for name, args in steps:
              act = actions_by_name.get(name.lower())
              if act is None:
                  return None
              params = []
              for a in args:
                  obj = objs_by_name.get(a.lower())
                  if obj is None:
                      return None
                  params.append(obj)
              try:
                  instances.append(ActionInstance(act, tuple(params)))
              except Exception:
                  return None
          try:
              return SequentialPlan(instances)
          except Exception:
              return None

      def _pyperplan_commands():
          cmds = []
          exe = shutil.which("pyperplan")
          if exe:
              cmds.append([exe])
          # ``python -m pyperplan`` works with the installed package even
          # when the console-script is missing.
          cmds.append([sys.executable, "-m", "pyperplan"])
          return cmds

      def _try_pyperplan_cli(dom, prob, s_alg, h_alg):
          with tempfile.TemporaryDirectory() as tmp:
              # Copy inputs so pyperplan's default "<problem>.soln" output
              # lands in a disposable directory even if the real inputs
              # live in a read-only tree.
              try:
                  dom_tmp = os.path.join(tmp, "domain.pddl")
                  prob_tmp = os.path.join(tmp, "problem.pddl")
                  shutil.copyfile(dom, dom_tmp)
                  shutil.copyfile(prob, prob_tmp)
              except OSError:
                  return None
              soln_candidates = [
                  prob_tmp + ".soln",
                  os.path.join(tmp, "problem.pddl.soln"),
                  os.path.join(tmp, "problem.soln"),
              ]
              for base in _pyperplan_commands():
                  cmd = list(base)
                  if s_alg:
                      cmd += ["-s", s_alg]
                  if h_alg:
                      cmd += ["-H", h_alg]
                  cmd += [dom_tmp, prob_tmp]
                  run_kw = {
                      "capture_output": True,
                      "text": True,
                      "cwd": tmp,
                  }
                  if timeout is not None:
                      try:
                          run_kw["timeout"] = float(timeout)
                      except (TypeError, ValueError):
                          pass
                  try:
                      subprocess.run(cmd, **run_kw)
                  except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
                      continue
                  except Exception:
                      continue
                  for cand in soln_candidates:
                      if os.path.isfile(cand):
                          try:
                              return _parse_soln(cand)
                          except Exception:
                              continue
          return None

      # ---- Path 1: pyperplan CLI yields a native lifted plan -----------
      if domain_path and problem_path:
          steps = _try_pyperplan_cli(
              domain_path, problem_path,
              requested_search, requested_heuristic,
          )
          if not steps and prefer_optimal:
              # Admissible search may time out on large instances; retry
              # with pyperplan's defaults (satisficing) so we still return
              # a plan with lifted action names.
              steps = _try_pyperplan_cli(domain_path, problem_path, None, None)
          if steps:
              real = _build_real_up_plan(steps)
              if real is not None:
                  return real
              return _SequentialPlanProxy(steps)

      # ---- Path 2: UP OneshotPlanner fallback --------------------------
      from unified_planning.shortcuts import OneshotPlanner, get_environment
      get_environment().credits_stream = None

      def _solve(planner):
          if timeout is not None:
              return planner.solve(problem, timeout=timeout)
          return planner.solve(problem)

      def _plan_of(result):
          if result is None:
              return None
          return getattr(result, "plan", None)

      if prefer_optimal:
          try:
              from unified_planning.engines.results import OptimalityGuarantee
              with OneshotPlanner(
                  problem_kind=problem.kind,
                  optimality_guarantee=OptimalityGuarantee.SOLVED_OPTIMALLY,
              ) as planner:
                  plan = _plan_of(_solve(planner))
                  if plan is not None:
                      return plan
          except Exception:
              pass

      if requested_search or requested_heuristic:
          params = {}
          if requested_search:
              params["search"] = requested_search
          if requested_heuristic:
              params["heuristic"] = requested_heuristic
          for kw_name in ("params", "parameters"):
              try:
                  with OneshotPlanner(
                      name=planner_name, **{kw_name: params}
                  ) as planner:
                      plan = _plan_of(_solve(planner))
                      if plan is not None:
                          return plan
              except Exception:
                  pass
          try:
              with OneshotPlanner(name=planner_name) as planner:
                  for attr in ("_options", "options", "_parameters", "parameters"):
                      opts = getattr(planner, attr, None)
                      if isinstance(opts, dict):
                          opts.update(params)
                  plan = _plan_of(_solve(planner))
                  if plan is not None:
                      return plan
          except Exception:
              pass

      with OneshotPlanner(name=planner_name) as planner:
          return _plan_of(_solve(planner))
