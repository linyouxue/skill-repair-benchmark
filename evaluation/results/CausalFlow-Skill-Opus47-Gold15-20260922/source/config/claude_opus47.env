# 路径可以写绝对路径，也可以写相对本交付包根目录的路径。
SKILLSBENCH_ROOT=../skillsbench
BENCHMARK_JOBS_ROOT=./runs
CAUSALFLOW_OUTPUT_ROOT=./outputs

# BenchFlow/LiteLLM 需要带 openrouter/ 前缀。
BENCHMARK_MODEL=openrouter/anthropic/claude-opus-4.7
BENCHMARK_REASONING_EFFORT=

# CausalFlow 直接请求 OpenRouter，模型名不带 openrouter/ 前缀。
CAUSALFLOW_MODEL=anthropic/claude-opus-4.7
CAUSALFLOW_REPAIR_MODEL=anthropic/claude-opus-4.7
CAUSALFLOW_CRITIC_MODEL=anthropic/claude-opus-4.7
CAUSALFLOW_META_CRITIC_MODEL=anthropic/claude-opus-4.7

METHOD_ID=causalflow-claude-opus47
CAUSALFLOW_TIMEOUT=900
CAUSALFLOW_CRS_INTERVENTIONS=1
CAUSALFLOW_REPAIR_PROPOSALS=3
CAUSALFLOW_LLM_MAX_TOKENS=2048
