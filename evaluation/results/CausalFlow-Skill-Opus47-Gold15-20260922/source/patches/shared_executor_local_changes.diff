+def _disable_uncontrolled_skill_discovery() -> None:
+    """Keep OpenHands from adding project, user, or public skills.
+
+    The benchmark executor injects the complete, digest-verified task bundle in
+    ``configure_agent``.  OpenHands CLI 1.28.1 otherwise performs a second skill
+    discovery pass while creating the session, including a network clone of its
+    public skill repository.  That changes the model-visible skill set and makes
+    an offline rollout depend on unrelated infrastructure.
+    """
+
+    from openhands.sdk.context import AgentContext
+    from openhands_cli.locations import get_work_dir
+    from openhands_cli.stores.agent_store import AgentStore
+    from openhands_cli.utils import get_os_description
+
+    if getattr(AgentStore, "_benchmark_executor_skill_isolation", False):
+        return
+
+    def executor_agent_context(self: Any) -> Any:
+        del self
+        system_suffix = "\n".join(
+            [
+                f"Your current working directory is: {get_work_dir()}",
+                f"User operating system: {get_os_description()}",
+            ]
+        )
+        return AgentContext(
+            skills=[],
+            system_message_suffix=system_suffix,
+            load_user_skills=False,
+            load_public_skills=False,
+        )
+
+    AgentStore._build_agent_context = executor_agent_context
+    AgentStore._benchmark_executor_skill_isolation = True
+
+
 def _positive_int(env: Mapping[str, str], key: str) -> int:
     raw = env.get(key, "")
     try:
@@ -310,6 +347,8 @@ def install_adapter(env: Mapping[str, str] | None = None) -> None:
 
     from openhands_cli.acp_impl.agent import base_agent, local_agent
 
+    _disable_uncontrolled_skill_discovery()
+
     original_conversation = local_agent.Conversation
 
     @wraps(original_conversation)
