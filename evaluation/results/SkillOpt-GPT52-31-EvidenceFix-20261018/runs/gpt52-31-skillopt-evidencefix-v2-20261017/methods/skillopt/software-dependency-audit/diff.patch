 ## Complete Vulnerability CSV Report Generator
 
+
+### Deterministic mapping + dedup example (Trivy JSON)
+
+Use a canonicalization pass that (a) filters to `HIGH`/`CRITICAL`, (b) normalizes fields, (c) deduplicates by `(Package,Version,CVE_ID)`, and (d) sorts stably.
+
+```python
+SEV_ORDER = {'CRITICAL': 0, 'HIGH': 1}
+
+def pick_url(vuln):
+    primary = (vuln.get('PrimaryURL') or '').strip()
+    if primary:
+        return primary
+    refs = vuln.get('References') or []
+    refs = sorted(r.strip() for r in refs if isinstance(r, str) and r.strip())
+    return refs[0] if refs else 'N/A'
+
+def pick_title(vuln):
+    t = (vuln.get('Title') or '').strip()
+    if t:
+        return t
+    d = (vuln.get('Description') or '').strip()
+    return d if d else 'No description'
+
+def normalize_record(vuln):
+    pkg = (vuln.get('PkgName') or '').strip()
+    ver = (vuln.get('InstalledVersion') or '').strip()
+    vid = (vuln.get('VulnerabilityID') or '').strip()
+    sev = (vuln.get('Severity') or 'UNKNOWN').strip().upper()
+
+    fixed = (vuln.get('FixedVersion') or '').strip() or 'N/A'
+    return {
+        'Package': pkg,
+        'Version': ver,
+        'CVE_ID': vid,
+        'Severity': sev,
+        'CVSS_Score': extract_cvss_score(vuln),
+        'Fixed_Version': fixed,
+        'Title': pick_title(vuln),
+        'Url': pick_url(vuln),
+    }
+
+def canonicalize(records):
+    # filter to intended severities only
+    records = [r for r in records if r.get('Severity') in ('HIGH', 'CRITICAL')]
+
+    # dedup by (Package, Version, CVE_ID)
+    dedup = {}
+    for r in records:
+        key = (r['Package'], r['Version'], r['CVE_ID'])
+        # keep first occurrence (deterministic because upstream iteration order is stable)
+        # alternatively, implement a deterministic “best row” selector if needed.
+        dedup.setdefault(key, r)
+
+    out = list(dedup.values())
+    out.sort(key=lambda r: (r['Package'], r['Version'], SEV_ORDER.get(r['Severity'], 9), r['CVE_ID']))
+    return out
+```
+
