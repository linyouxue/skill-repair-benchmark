+package org.apache.druid.query.filter;
+
+import com.fasterxml.jackson.databind.InjectableValues;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import org.apache.druid.jackson.DefaultObjectMapper;
+import org.apache.druid.js.JavaScriptConfig;
+import org.apache.druid.math.expr.ExprMacroTable;
+import org.apache.druid.query.expression.TestExprMacroTable;
+import org.apache.druid.segment.filter.JavaScriptFilter;
+import org.apache.druid.timeline.DataSegment.PruneSpecsHolder;
+import org.junit.Assert;
+import org.junit.Test;
+
+public class JavaScriptConfigJacksonInjectTest
+{
+  private static ObjectMapper makeJsonMapperWithInjectedJsConfig(final JavaScriptConfig config)
+  {
+    final ObjectMapper mapper = new DefaultObjectMapper();
+    mapper.setInjectableValues(
+        new InjectableValues.Std()
+            .addValue(ExprMacroTable.class.getName(), TestExprMacroTable.INSTANCE)
+            .addValue(ObjectMapper.class.getName(), mapper)
+            .addValue(PruneSpecsHolder.class, PruneSpecsHolder.DEFAULT)
+            .addValue(JavaScriptConfig.class, config)
+    );
+    return mapper;
+  }
+
+  @Test
+  public void testEmptyKeyCannotOverrideInjectedJavaScriptConfig() throws Exception
+  {
+    final ObjectMapper mapper = makeJsonMapperWithInjectedJsConfig(new JavaScriptConfig(false));
+
+    final String json = "{\n"
+                        + "  \"type\": \"javascript\",\n"
+                        + "  \"dimension\": \"x\",\n"
+                        + "  \"function\": \"function(x){return true;}\",\n"
+                        + "  \"\": {\"enabled\": true}\n"
+                        + "}";
+
+    final DimFilter dimFilter = mapper.readValue(json, DimFilter.class);
+    Assert.assertTrue(dimFilter instanceof JavaScriptDimFilter);
+
+    try {
+      dimFilter.toFilter();
+      Assert.fail("Expected JavaScript to remain disabled via injection");
+    }
+    catch (IllegalStateException e) {
+      Assert.assertTrue(e.getMessage().contains("JavaScript is disabled"));
+    }
+  }
+
+  @Test
+  public void testLegitimateJavaScriptDimFilterStillWorksWhenInjectedEnabled() throws Exception
+  {
+    final ObjectMapper mapper = makeJsonMapperWithInjectedJsConfig(JavaScriptConfig.getEnabledInstance());
+
+    final String json = "{\n"
+                        + "  \"type\": \"javascript\",\n"
+                        + "  \"dimension\": \"x\",\n"
+                        + "  \"function\": \"function(x){return true;}\"\n"
+                        + "}";
+
+    final DimFilter dimFilter = mapper.readValue(json, DimFilter.class);
+    Assert.assertTrue(dimFilter instanceof JavaScriptDimFilter);
+
+    final Filter filter = dimFilter.toFilter();
+    Assert.assertTrue(filter instanceof JavaScriptFilter);
+  }
+}
