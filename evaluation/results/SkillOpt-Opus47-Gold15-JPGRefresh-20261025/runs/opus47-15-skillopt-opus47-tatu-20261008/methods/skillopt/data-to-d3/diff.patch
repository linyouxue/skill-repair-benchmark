+### Bidirectional chart ↔ table linking (shared dispatcher)
+
+```javascript
+let selectedId = null;
+function select(id) {
+    selectedId = (selectedId === id) ? null : id;   // toggle
+    highlightChart(selectedId);
+    highlightTable(selectedId);
+}
+bubbles.on('click', (_, d) => select(d.ticker));
+tableRows.on('click', d => select(d.ticker));
+
+function highlightChart(id) {
+    bubbles.classed('selected', d => d.ticker === id);
+}
+function highlightTable(id) {
+    tableRows.classed('selected', d => d.ticker === id);
+    if (id) {
+        const row = document.querySelector(`tr[data-ticker="${id}"]`);
+        if (row) row.scrollIntoView({ block: 'nearest' });
+    }
+}
+```
+
+CSS:
+```css
+circle.bubble.selected { stroke: #111; stroke-width: 3px; }
+tr.selected            { background: #fff3a3; font-weight: 600; }
+```
