+### Clustered force-directed bubble chart
+
+```javascript
+// Radius: AREA (not radius) proportional to size field; uniform fallback for missing values.
+const UNIFORM_R = 20;
+const rScale = d3.scaleSqrt()
+    .domain([0, d3.max(data, d => d.marketCap || 0)])
+    .range([14, 52]);
+const radius = d => (d.marketCap ? rScale(d.marketCap) : UNIFORM_R);
+
+// Deterministic per-sector cluster centers on a circle around chart center.
+const sectors = Array.from(new Set(data.map(d => d.sector))).sort();
+const cx = width / 2, cy = height / 2;
+const R  = Math.min(width, height) * 0.24;
+const centers = new Map(sectors.map((s, i) => {
+    const a = (i / sectors.length) * 2 * Math.PI;
+    return [s, { x: cx + R * Math.cos(a), y: cy + R * Math.sin(a) }];
+}));
+
+// Deterministic initial positions (no Math.random): seed from index.
+data.forEach((d, i) => {
+    const c = centers.get(d.sector);
+    d.x = c.x + ((i * 37) % 11) - 5;
+    d.y = c.y + ((i * 53) % 11) - 5;
+});
+
+const sim = d3.forceSimulation(data)
+    .force('x', d3.forceX(d => centers.get(d.sector).x).strength(0.15))
+    .force('y', d3.forceY(d => centers.get(d.sector).y).strength(0.15))
+    .force('charge', d3.forceManyBody().strength(-10))
+    .force('collide', d3.forceCollide(d => radius(d) + 2).iterations(3))
+    .stop();
+for (let i = 0; i < 300; i++) sim.tick();   // warm-up for deterministic layout
+```
