+    # it does not advertise a session/set_config_option effort control.
+    if agent == "openhands" and reasoning_effort:
+        agent_env = {**agent_env, "LLM_REASONING_EFFORT": reasoning_effort}
+
     # Resolve agent binary path for non-docker environments
     if environment != "docker":
         which_result = await env.exec(
@@ -676,7 +687,7 @@ async def execute_prompts(
                     or (
                         isinstance(text_only_retry_limit, int)
                         and not isinstance(text_only_retry_limit, bool)
